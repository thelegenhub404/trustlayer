{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/v1/search", "destination": "/api/search" },
    { "source": "/v1/agents/:id", "destination": "/api/agents?id=:id" },
    { "source": "/v1/verify", "destination": "/api/verify" },
    { "source": "/v1/index/meta", "destination": "/api/meta" },
    { "source": "/agent/:id", "destination": "/agent.html" },
    { "source": "/badge/:id", "destination": "/api/badge?id=:id" }
  ],
  "functions": {
    "api/*.py": { "includeFiles": "data/**", "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/v1/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Cache-Control", "value": "public, s-maxage=300, stale-while-revalidate=600" }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
